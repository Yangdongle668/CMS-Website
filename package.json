{
  "name": "battery-cms",
  "version": "1.0.0",
  "private": true,
  "description": "B2B lithium battery manufacturer CMS with pillar pages, inquiry capture, and GDPR compliance",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/init.js --seed",
    "retention": "node server/jobs/retention.js",
    "images:localize": "node scripts/download-unsplash-images.js",
    "images:optimize": "node scripts/optimize-seed-images.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
