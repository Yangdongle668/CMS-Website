{
  "name": "battery-cms",
  "version": "1.0.0",
  "private": true,
  "description": "B2B lithium battery manufacturer CMS with pillar pages, inquiry capture, and GDPR compliance",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/init.js --seed",
    "retention": "node server/jobs/retention.js",
    "smtp:doctor": "node scripts/smtp-doctor.js",
    "images:localize": "node scripts/download-unsplash-images.js",
    "images:optimize": "node scripts/optimize-images.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overridesRationale": {
    "qs": "Reaches us transitively through express 4 and body-parser, which pin a range npm audit fix will not lift on its own. Versions up to 6.15.3 carry a parse-side DoS and an array-limit bypass, both reachable through ordinary query strings. Drop the override once express 4 resolves to a fixed qs by itself."
  },
  "overrides": {
    "qs": "^6.15.4"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
