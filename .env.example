# ===== Server =====
NODE_ENV=development
PORT=3000
PUBLIC_URL=https://zufek.com
SITE_NAME="Zufek"

# Set to "true" ONLY when the site is served over real HTTPS (TLS).
# Enables HSTS + upgrade-insecure-requests. If you set this without TLS
# in place, browsers will refuse to load CSS/JS until the cache expires.
FORCE_HTTPS=false

# ===== PostgreSQL =====
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=battery_cms
# Or use a single connection string (overrides the above if set)
# DATABASE_URL=postgres://user:pass@host:5432/battery_cms

# ===== Auth =====
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_SECRET=change-this-too
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMe!2026

# ===== SMTP (Nodemailer) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Zufek Sales <info@zufek.com>"
INQUIRY_RECIPIENTS=sales@example.com,manager@example.com

# ===== Cloudflare Turnstile =====
TURNSTILE_SITE_KEY=0x000000000000000000
TURNSTILE_SECRET_KEY=0x000000000000000000

# ===== GDPR =====
GDPR_RETENTION_DAYS=365
GDPR_SOFT_DELETE_DAYS=30
PRIVACY_POLICY_VERSION=1.0
