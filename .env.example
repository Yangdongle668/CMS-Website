# ===== Server =====
NODE_ENV=development
PORT=3000
PUBLIC_URL=https://zufek.com
SITE_NAME="Zufek"

# Set to "true" ONLY when the site is served over real HTTPS (TLS).
# Enables HSTS + upgrade-insecure-requests. If you set this without TLS
# in place, browsers will refuse to load CSS/JS until the cache expires.
FORCE_HTTPS=false

# ===== PostgreSQL =====
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=battery_cms
# Or use a single connection string (overrides the above if set)
# DATABASE_URL=postgres://user:pass@host:5432/battery_cms

# ===== Auth =====
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_SECRET=change-this-too
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMe!2026

# ===== SMTP (Nodemailer) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Zufek Sales <info@zufek.com>"
INQUIRY_RECIPIENTS=sales@example.com,manager@example.com

# ===== Cloudflare Turnstile =====
TURNSTILE_SITE_KEY=0x000000000000000000
TURNSTILE_SECRET_KEY=0x000000000000000000

# ===== GDPR =====
GDPR_RETENTION_DAYS=365
GDPR_SOFT_DELETE_DAYS=30
PRIVACY_POLICY_VERSION=1.0

# ===== Mail outbox + reliability =====
# All transactional emails go through a DB-backed outbox so SMTP slowness
# never blocks inquiry submission. Defaults are safe — uncomment to tune.
# OUTBOX_POLL_MS=5000          # how often the worker polls (ms)
# OUTBOX_BATCH=5               # max messages claimed per tick
# OUTBOX_DISABLED=false        # set true to run a web-only node
# HEALTH_ALERTS_DISABLED=false # email the team on dead-letter / overdue

# ===== Emergency store =====
# Inquiries are written here as NDJSON if PostgreSQL is unreachable at
# the moment of submission. They are replayed automatically at boot.
# In Docker this points to a named volume (/app/data).
EMERGENCY_DIR=./data

# ===== Connection pool tuning =====
# PGPOOL_MAX=10
# PG_RETRY_MAX=3
# PG_RETRY_BASE_MS=200

# ===== AI 文章生成 — 多 LLM Provider 接入 =====
# 推荐通过 后台 → 站点设置 → AI 接入 来管理（保存即生效，无需重启）。
# 这里的 env 变量仅作为初始 fallback / 容器化部署时的预填值。
#
# 也可以这里留空 → 启动后到后台填，DB 中的设置会覆盖 env。
#
# AI_PROVIDER (optional) — 默认 provider 的 fallback，UI 中可覆盖。
#   anthropic | openai | deepseek | moonshot | zhipu | qwen | openai_compat
AI_PROVIDER=
AI_MAX_TOKENS=4096

# ----- Anthropic Claude -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- OpenAI -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- DeepSeek (国内) -----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ----- 月之暗面 Kimi (国内) -----
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-32k

# ----- 智谱 GLM (国内) -----
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-plus

# ----- 阿里通义千问 (国内, OpenAI 兼容模式) -----
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# ----- 自定义 OpenAI 兼容端点 -----
# 例如 私有部署的 vLLM / Ollama / OneAPI 网关
OPENAI_COMPAT_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ===== AI 内容检测 =====
# AI_DETECT_PROVIDER:
#   - "heuristic" (default, free, no external call) — uses sentence-length
#     burstiness, AI-tic phrases, em-dash density and vocabulary variance to
#     produce a 0-100 AI-likelihood score plus highlighted suspicious spans.
#   - "gptzero" — calls https://api.gptzero.me/v2/predict/text. Requires
#     GPTZERO_API_KEY. Falls back to heuristic if the upstream call fails.
#   - "sapling" — calls https://api.sapling.ai/api/v1/aidetect. Requires
#     SAPLING_API_KEY.
AI_DETECT_PROVIDER=heuristic
GPTZERO_API_KEY=
SAPLING_API_KEY=
# Score (0-100) above which the workflow recommends a "降AI" pass.
AI_DETECT_THRESHOLD=45
